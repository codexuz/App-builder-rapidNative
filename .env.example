# Get your API key from https://kie.ai/api-key
KIE_API_KEY=your_kie_api_key_here

# Optional: override default Kie.ai image model
# Popular options:
#   gpt-image-2-6/flare-text-to-image   (fast, crisp UI/app assets, default)
#   gpt-image-2-6/economy-text-to-image (budget 1K)
#   google/nano-banana                  (fast illustration/artwork)
#   flux-3/klein-text-to-image          (photorealistic scenes)
KIE_DEFAULT_IMAGE_MODEL=gpt-image-2-6/flare-text-to-image

# Optional: Expo EAS token for cloud iOS/Android builds
# EXPO_TOKEN=your_expo_token_here
